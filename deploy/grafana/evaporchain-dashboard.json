{
  "dashboard": {
    "title": "EvaporChain Node Health",
    "uid": "evaporchain-health",
    "tags": ["evaporchain", "blockchain"],
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Block Height",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
        "targets": [{ "expr": "evaporchain_block_height", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "none" } }
      },
      {
        "id": 2,
        "title": "Current TPS",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
        "targets": [{ "expr": "evaporchain_tps", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "ops", "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 100, "color": "yellow" }, { "value": 1000, "color": "green" }] } } }
      },
      {
        "id": 3,
        "title": "Peak TPS",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
        "targets": [{ "expr": "evaporchain_peak_tps", "legendFormat": "{{instance}}" }]
      },
      {
        "id": 4,
        "title": "Active Objects",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
        "targets": [{ "expr": "evaporchain_active_objects", "legendFormat": "{{instance}}" }]
      },
      {
        "id": 5,
        "title": "Ghost Count",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
        "targets": [{ "expr": "evaporchain_ghost_count", "legendFormat": "{{instance}}" }]
      },
      {
        "id": 6,
        "title": "Peer Count",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
        "targets": [{ "expr": "evaporchain_peer_count", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "yellow" }, { "value": 3, "color": "green" }] } } }
      },
      {
        "id": 7,
        "title": "Block Height Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [{ "expr": "evaporchain_block_height", "legendFormat": "{{instance}}" }]
      },
      {
        "id": 8,
        "title": "TPS Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          { "expr": "evaporchain_tps", "legendFormat": "current {{instance}}" },
          { "expr": "evaporchain_peak_tps", "legendFormat": "peak {{instance}}" }
        ]
      },
      {
        "id": 9,
        "title": "State Objects vs Ghosts",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          { "expr": "evaporchain_active_objects", "legendFormat": "active {{instance}}" },
          { "expr": "evaporchain_ghost_count", "legendFormat": "ghosts {{instance}}" }
        ]
      },
      {
        "id": 10,
        "title": "Block Execution Time (ms)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [{ "expr": "evaporchain_avg_block_exec_ms", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "ms" } }
      },
      {
        "id": 11,
        "title": "Total Transactions",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "targets": [{ "expr": "rate(evaporchain_total_transactions[5m])", "legendFormat": "tx/s {{instance}}" }]
      },
      {
        "id": 12,
        "title": "Gas Per Block",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "targets": [{ "expr": "evaporchain_avg_gas_per_block", "legendFormat": "{{instance}}" }]
      },
      {
        "id": 13,
        "title": "Fee Base (ppm)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
        "targets": [{ "expr": "evaporchain_fee_base_ppm", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "none", "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 5000000, "color": "yellow" }, { "value": 10000000, "color": "red" }] } } }
      },
      {
        "id": 14,
        "title": "EPV Live Versions",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 28 },
        "targets": [{ "expr": "evaporchain_epv_live_versions", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "none" } }
      },
      {
        "id": 15,
        "title": "Autopoietic Viability",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 28 },
        "targets": [{ "expr": "evaporchain_autopoietic_viability", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "none", "mappings": [{ "type": "value", "options": { "0": { "text": "Inviable", "color": "red" }, "1": { "text": "Stressed", "color": "yellow" }, "2": { "text": "Viable", "color": "green" } } }] } }
      },
      {
        "id": 16,
        "title": "Consensus Phase",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 28 },
        "targets": [{ "expr": "evaporchain_consensus_phase", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "none", "mappings": [{ "type": "value", "options": { "0": { "text": "Chaotic", "color": "red" }, "1": { "text": "Frozen", "color": "orange" }, "2": { "text": "SafetyStable", "color": "yellow" }, "3": { "text": "LivenessStable", "color": "green" } } }] } }
      },
      {
        "id": 17,
        "title": "Fee Base Over Time (ppm)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "targets": [{ "expr": "evaporchain_fee_base_ppm", "legendFormat": "{{instance}}" }],
        "fieldConfig": { "defaults": { "unit": "none" } }
      },
      {
        "id": 18,
        "title": "Autopoietic Viability Over Time",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "targets": [
          { "expr": "evaporchain_autopoietic_viability", "legendFormat": "viability {{instance}}" },
          { "expr": "evaporchain_consensus_phase", "legendFormat": "consensus {{instance}}" }
        ],
        "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 3 } }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(evaporchain_block_height, instance)",
          "refresh": 2
        }
      ]
    }
  }
}
