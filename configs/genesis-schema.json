{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evaporchain.com/schemas/genesis.json",
  "title": "EvaporChain Genesis Configuration",
  "description": "Schema for EvaporChain genesis configuration files",
  "type": "object",
  "required": ["chain_id", "genesis_time", "consensus", "validators", "accounts"],
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "type": "string",
      "pattern": "^evaporchain-[a-z0-9-]+$",
      "description": "Unique chain identifier (e.g., evaporchain-mainnet-1)"
    },
    "genesis_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 genesis timestamp"
    },
    "consensus": {
      "type": "object",
      "required": ["type", "block_interval_ms"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["tendermint", "mock"],
          "description": "Consensus algorithm"
        },
        "block_interval_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "description": "Target block interval in milliseconds"
        },
        "grace_period": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Number of rounds to wait before timing out"
        },
        "max_rounds_per_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum consensus rounds before forcing a block"
        }
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "stake", "address"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "description": "Unique validator ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Human-readable validator name"
          },
          "stake": {
            "type": "integer",
            "minimum": 1,
            "description": "Initial stake amount"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]+$",
            "description": "Validator address (hex)"
          },
          "p2p_address": {
            "type": "string",
            "description": "libp2p multiaddr for peer discovery"
          },
          "bls_public_key": {
            "type": "string",
            "description": "BLS12-381 public key (hex) for aggregate signatures"
          }
        }
      }
    },
    "bootstrap_peers": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "libp2p multiaddr of bootstrap peers"
      },
      "default": []
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "balance"],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "description": "Account address (32-byte hex)"
          },
          "balance": {
            "type": "integer",
            "minimum": 0,
            "description": "Initial balance"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label for this account"
          }
        }
      }
    }
  }
}
