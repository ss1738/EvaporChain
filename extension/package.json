{
  "name": "evaporchain-wallet-extension",
  "version": "0.1.0",
  "description": "EvaporChain Wallet — Post-quantum browser extension wallet with live energy decay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build:wasm": "bash scripts/build-wasm.sh",
    "verify:wasm": "node scripts/verify-wasm.mjs",
    "prebuild": "node scripts/verify-wasm.mjs",
    "build": "tsc && vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0"
  }
}
