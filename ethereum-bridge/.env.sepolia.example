# ─────────────────────────────────────────────────────────────────────────────
# EvaporChain → Ethereum Bridge: Sepolia deployment configuration
#
# Copy to .env.sepolia, fill in the blanks, then source before running:
#   source .env.sepolia && forge script …
#   source .env.sepolia && cargo run -p evaporchain-eth-relayer
# ─────────────────────────────────────────────────────────────────────────────

# ── Ethereum (Sepolia) ───────────────────────────────────────────────────────

# Sepolia RPC endpoint. Public options:
#   https://rpc.sepolia.org
#   https://sepolia.infura.io/v3/<PROJECT_ID>
#   https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
ETHEREUM_RPC=https://rpc.sepolia.org

# Deployer / relayer private key (funded with Sepolia ETH).
# Get test ETH from: https://sepoliafaucet.com / https://www.alchemy.com/faucets/ethereum-sepolia
# Keep this secret — never commit the actual value.
PRIVATE_KEY=0x<YOUR_SEPOLIA_PRIVATE_KEY>

# Etherscan API key (only needed for --verify flag during deployment).
# Get from: https://etherscan.io/myapikey
ETHERSCAN_KEY=<YOUR_ETHERSCAN_API_KEY>

# ── Deployed contract addresses (fill in after running Deploy.s.sol) ─────────

VERIFIER_ADDR=0x<CommitCertVerifier address>
REGISTRY_ADDR=0x<ValidatorSetRegistry address>
INBOX_ADDR=0x<EvaporHeaderInbox address>
ATTESTER_ADDR=0x<StateMembershipAttester address>
DISPATCHER_ADDR=0x<EvaporationDispatcher address>

# ── EvaporChain relayer ──────────────────────────────────────────────────────

# HTTP API of an EvaporChain node (Mini cluster or public RPC).
EVAPORCHAIN_RPC=http://100.119.53.101:8080

# Same as INBOX_ADDR above — the contract the relayer submits headers to.
INBOX_ADDRESS=$INBOX_ADDR

# Private key used by the relayer to sign Ethereum transactions.
# Can be the same as PRIVATE_KEY or a separate funded key.
RELAYER_PRIVATE_KEY=$PRIVATE_KEY

# How often to poll for new EvaporChain finalisations (seconds).
POLL_INTERVAL_SECS=15

# ── Optional overrides ────────────────────────────────────────────────────────

# Start relaying from this EvaporChain height (instead of the latest committed height).
# Useful when re-deploying contracts mid-chain.
# START_HEIGHT_OVERRIDE=10000

# ── Deployment commands (read-only reference) ─────────────────────────────────
#
# 1. Generate genesis calldata from the live Mini cluster:
#      export GENESIS_CALLDATA=$(python3 scripts/genesis_init.py \
#          --node $EVAPORCHAIN_RPC --epoch 0)
#
# 2. Deploy all 5 contracts and seed the genesis valset:
#      forge script script/Deploy.s.sol \
#          --broadcast --rpc-url $ETHEREUM_RPC --private-key $PRIVATE_KEY \
#          --verify --etherscan-api-key $ETHERSCAN_KEY
#
# 3. Fill in the addresses from the forge output into this file.
#
# 4. Start the relayer:
#      source .env.sepolia
#      cargo run --release -p evaporchain-eth-relayer
#
# Gas budget estimates (Sepolia gwei prices roughly 10x lower than mainnet):
#   Deploy all 5 contracts: ~2.5M gas
#   submitHeader (5 signers): ~980k gas per header
#   dispatch (evaporation): ~672k gas per event
